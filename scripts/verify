#!/usr/bin/env bash
# KList's own gate: syntax pass on every tracked PHP file, then the tests under tests/.
# Run from the repo root: bash scripts/verify   (exit 0 = green)
set -euo pipefail
cd "$(dirname "$0")/.."

git ls-files '*.php' | while read -r f; do
    php -l "$f" >/dev/null || { echo "verify: syntax error in $f" >&2; exit 1; }
done
echo "verify: syntax ok"

# PHP 8.5 has no imap extension: no imap_*() call may be left. Comment lines are skipped;
# lib/PHPMailer is skipped, its one call sits behind function_exists().
calls=$(git ls-files '*.php' | grep -v '^lib/PHPMailer/' \
    | xargs grep -nE '\bimap_[a-z0-9_]+[[:space:]]*\(' \
    | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(\*|//|/\*)' || true)
if [ -n "$calls" ]; then
    echo "verify: imap_*() calls left:" >&2
    echo "$calls" >&2
    exit 1
fi
echo "verify: no imap_*() call"

# PHP 8.5 deprecations named by the port (dev37 runs 8.4, so 8.5-only ones are grepped):
# non-canonical casts, PHPMailer::$isHTML set as a property, index.php catching only Exception
# around IMAP (a missing extension or a TypeError must give a message, not a 500).
dep=$(git ls-files '*.php' | grep -v '^lib/PHPMailer/' \
    | xargs grep -nE '\((integer|boolean|double|binary)\)|->isHTML[[:space:]]*=[^=]' \
    | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(\*|//|/\*)' || true)
dep+=$(grep -nE 'catch[[:space:]]*\([[:space:]]*\\?Exception[[:space:]]' index.php || true)
if [ -n "$dep" ]; then
    echo "verify: PHP 8.5 deprecations left:" >&2
    echo "$dep" >&2
    exit 1
fi
echo "verify: no PHP 8.5 deprecation left"

# The repo is the docroot: every tracked top-level directory but assets/ must be denied by
# .htaccess, or a new one (as tests/ and scripts/ were) is served as it stands.
open=$(git ls-files | grep / | cut -d/ -f1 | sort -u | grep -vx assets \
    | while read -r d; do grep -qE "^[[:space:]]*RewriteRule \^$d/ - \[F" .htaccess || echo "$d/"; done)
if [ -n "$open" ]; then
    echo "verify: not denied by .htaccess: $open" >&2
    exit 1
fi
echo "verify: .htaccess denies every directory but assets/"

# Tests run with every notice on: a deprecation (dynamic property…) or warning is a failure.
for t in tests/*_test.php; do
    out=$(php -d error_reporting=-1 -d display_errors=stderr -d log_errors=0 "$t" 2>&1) \
        || { echo "$out" >&2; exit 1; }
    echo "$out"
    if grep -qE '^(PHP )?(Deprecated|Warning|Notice):' <<<"$out"; then
        echo "verify: $t raised a deprecation/warning" >&2
        exit 1
    fi
done
echo "verify: green"
